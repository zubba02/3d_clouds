HIMAWARI_BUCKET = "noaa-himawari9"
HIMAWARI_SEGMENTS = (4, 5, 6)       # full-disk segments covering ~10°S-20°N at 67-84°E


def himawari_fetch(t_utc, cache):
    import s3fs
    fs = s3fs.S3FileSystem(anon=True)
    t = t_utc.replace(minute=t_utc.minute - t_utc.minute % 10, second=0)
    prefix = f"{HIMAWARI_BUCKET}/AHI-L1b-FLDK/{t:%Y/%m/%d/%H%M}/"
    out = []
    for seg in HIMAWARI_SEGMENTS:
        name = f"HS_H09_{t:%Y%m%d_%H%M}_B13_FLDK_R20_S{seg:02d}10.DAT"
        local = os.path.join(cache, name)
        if not os.path.exists(local):
            try:
                with fs.open(prefix + name + ".bz2", "rb") as src, \
                        open(local + ".part", "wb") as dst:
                    dst.write(bz2.decompress(src.read()))
                os.replace(local + ".part", local)
            except FileNotFoundError:
                return None
        out.append(local)
    return out


def himawari_bt(files, area):
    from satpy import Scene
    scn = Scene(reader="ahi_hsd", filenames=files)
    scn.load(["B13"])
    res = scn.resample(area, resampler="bilinear", radius_of_influence=15000)
    return np.asarray(res["B13"].values, float)


# ---------------------------------------------------------------------------
# Source 2: Meteosat IODC (EUMETSAT Data Store)
# ---------------------------------------------------------------------------
IODC_COLLECTION = "EO:EUM:DAT:MSG:HRSEVIRI-IODC"


def meteosat_products(times):
    import eumdac
    key, secret = os.environ.get("EUMETSAT_KEY"), os.environ.get("EUMETSAT_SECRET")
    if not (key and secret):
        sys.exit("Set EUMETSAT_KEY and EUMETSAT_SECRET for --source meteosat")
    store = eumdac.DataStore(eumdac.AccessToken((key, secret)))
    coll = store.get_collection(IODC_COLLECTION)
    prods = list(coll.search(dtstart=times[0] - dt.timedelta(minutes=10),
                             dtend=times[-1] + dt.timedelta(minutes=20)))
    if not prods:
        sys.exit("No Meteosat IODC products for that day - try --source himawari")
    starts = [p.sensing_start.replace(tzinfo=dt.timezone.utc) for p in prods]
    chosen = []
    for t in times:
        i = int(np.argmin([abs((s - t).total_seconds()) for s in starts]))
        chosen.append(prods[i] if abs((starts[i] - t).total_seconds()) < 900 else None)
    return chosen


def meteosat_fetch(product, cache):
    if product is None:
        return None
    nat = [e for e in product.entries if e.endswith(".nat")]
    if not nat:
        return None
    local = os.path.join(cache, os.path.basename(nat[0]))
    if not os.path.exists(local):
        with product.open(entry=nat[0]) as src, open(local + ".part", "wb") as dst:
            shutil.copyfileobj(src, dst)
        os.replace(local + ".part", local)
    return [local]


def meteosat_bt(files, area):
    from satpy import Scene
    scn = Scene(reader="seviri_l1b_native", filenames=files)
    scn.load(["IR_108"])
    res = scn.resample(area, resampler="bilinear", radius_of_influence=10000)
    return np.asarray(res["IR_108"].values, float)


# ---------------------------------------------------------------------------
# Synthetic demo field (only for testing the renderer without downloads)
# ---------------------------------------------------------------------------
def _spectral_noise(shape, beta, rng):
    """Smooth random field with power spectrum ~ k^-beta over all axes."""
    f = np.fft.fftn(rng.normal(size=shape))
    k = np.sqrt(sum(np.meshgrid(*[np.fft.fftfreq(n) ** 2 for n in shape],
                                indexing="ij")))
    k[(0,) * len(shape)] = 1
    out = np.real(np.fft.ifftn(f * k ** (-beta / 2)))
    return (out - out.mean()) / out.std()


def demo_bt_series(times, seed=3):
    rng = np.random.default_rng(seed)
    lon, lat = grid_lonlat()
    ny, nx = lon.shape
    nt = len(times)
    # evolving texture fields (time, y, x), generated at half resolution
    tex = _spectral_noise((nt, (ny + 1) // 2, (nx + 1) // 2), 3.2, rng)
    fine = _spectral_noise((nt, (ny + 1) // 2, (nx + 1) // 2), 2.2, rng)
    tex = ndimage.zoom(tex, (1, 2, 2), order=1)[:, :ny, :nx]
    fine = ndimage.zoom(fine, (1, 2, 2), order=1)[:, :ny, :nx]
    # convective systems drifting west with a morning peak over the ocean
    systems = []
    for _ in range(24):
        systems.append(dict(x=rng.uniform(LON_MIN, LON_MAX + 2),
                            y=rng.uniform(LAT_MIN, LAT_MAX),
                            u=rng.normal(-0.05, 0.02), v=rng.normal(0.0, 0.015),
                            t0=rng.uniform(-0.3, 1.0) * nt,
                            life=rng.uniform(0.3, 0.7) * nt,
                            rx=rng.uniform(0.4, 1.4), ry=rng.uniform(0.3, 0.9),
                            depth=rng.uniform(25, 62)))
    out = []
    for k in range(nt):
        hours = k * 24 / nt
        diurnal = 0.75 + 0.25 * np.cos(2 * np.pi * (hours - 6) / 24)
        env = np.zeros_like(lon)
        for s in systems:
            age = (k - s["t0"]) / s["life"]
            if not 0 <= age <= 1:
                continue
            a = np.sin(np.pi * age) ** 1.2
            x, y = s["x"] + s["u"] * (k - s["t0"]), s["y"] + s["v"] * (k - s["t0"])
            d = ((lon - x) / s["rx"]) ** 2 + ((lat - y) / s["ry"]) ** 2
            env = np.maximum(env, a * s["depth"] * np.exp(-d * 1.6))
        bt = 298.5 - 4 * np.clip(fine[k], 0, None)
        bt -= 30 * np.clip(tex[k] + 0.05, 0, None) ** 1.4          # broken cloud field
        cells = np.clip(0.6 + 0.35 * fine[k] + 0.25 * tex[k], 0.1, 1.0)
        bt -= diurnal * env * cells                                  # towering cells
        out.append(185 + (np.clip(bt, 150, 300) - 185) * (bt > 185) + 6 * np.tanh((bt - 185) / 6) * (bt <= 185))
    return out


# ---------------------------------------------------------------------------
# 3-D rendering with PyVista
# ---------------------------------------------------------------------------
class Renderer:
    def __init__(self, segs, elev=62, orbit=32, dist=27):
        self.elev, self.orbit, self.dist = elev, orbit, dist
        self.outlines = atoll_outlines(segs)
        import pyvista as pv
        self.pv = pv
        pv.OFF_SCREEN = True
        lon, lat = grid_lonlat()
        self.lon, self.lat = lon, lat
        self.p = pv.Plotter(off_screen=True, window_size=(WIDTH, HEIGHT),
                            lighting="none")
        self.p.set_background(SEA_RGB / 255 * 1.08)   # blends with the lit sea
        self.p.enable_anti_aliasing("msaa", multi_samples=8)

        # cloud / sea surface (one mesh, heights updated per frame)
        self.actor = None

        # coastlines: thin white lines just above the sea
        pts, lines, off = [], [], 0
        for s in segs:
            n = len(s)
            pts.append(np.c_[s, np.full(n, 0.012)])
            lines.append(np.r_[n, np.arange(off, off + n)])
            off += n
        coast = pv.PolyData(np.vstack(pts), lines=np.hstack(lines))
        self.p.add_mesh(coast, color="white", line_width=2.2, opacity=0.95)

        # light from the north-west, high, like a late-afternoon sun
        self.p.add_light(pv.Light(position=(-1.0, 1.2, 1.6), focal_point=(0, 0, 0),
                                  light_type="scene light", intensity=1.0))
        self.p.add_light(pv.Light(position=(1, -1, 0.6), light_type="scene light",
                                  intensity=0.25))
        self.p.camera.SetViewAngle(30)

    def set_camera(self, k, n):
        """Look down at ELEV degrees and orbit back and forth through ORBIT degrees."""
        cx, cy = CAM_CENTER
        az = np.radians(0.5 * self.orbit * np.sin(2 * np.pi * k / n))
        el = np.radians(self.elev)
        self.cam_pos = np.array([cx + self.dist * np.cos(el) * np.sin(az),
                                 cy - self.dist * np.cos(el) * np.cos(az),
                                 self.dist * np.sin(el)])
        self.p.camera_position = [tuple(self.cam_pos), (cx, cy, 0.0), (0, 0, 1)]
        self.p.reset_camera_clipping_range()

    def project(self, pts):
        """World -> pixel coordinates (top-left origin) for the current view."""
        import vtk
        c = vtk.vtkCoordinate()
        c.SetCoordinateSystemToWorld()
        out = []
        for p_ in pts:
            c.SetValue(*p_)
            x, y = c.GetComputedDoubleDisplayValue(self.p.renderer)
            out.append((x, HEIGHT - y))
        return out

    def occluded(self, lon0, lat0, z_surface):
        """True if the cloud surface blocks the line of sight to (lon0, lat0)."""
        p0 = np.array([lon0, lat0, 0.02])
        ts = np.linspace(0.002, 0.35, 120)
        ray = p0 + ts[:, None] * (self.cam_pos - p0)
        col = (ray[:, 0] - (LON_MIN + RES / 2)) / RES
        row = ((LAT_MAX - RES / 2) - ray[:, 1]) / RES
        zs = ndimage.map_coordinates(z_surface, [row, col], order=1, cval=0.0)
        return bool(np.any(zs > ray[:, 2]))

    def frame(self, bt, k, n):
        bt = np.nan_to_num(np.asarray(bt, float), nan=T_SURF)
        if bt.shape != self.lon.shape:          # safety net: never crash on a 1-px mismatch
            bt = ndimage.zoom(bt, (self.lon.shape[0] / bt.shape[0],
                                   self.lon.shape[1] / bt.shape[1]), order=1)
            bt = bt[:self.lon.shape[0], :self.lon.shape[1]]
        bt = ndimage.gaussian_filter(bt, 1.1)
        z = bt_to_height_km(bt) * Z_SCALE
        grid = self.pv.StructuredGrid(self.lon, self.lat, z)
        grid["rgb"] = bt_to_rgb(bt).reshape(-1, 3, order="F")
        surf = grid.extract_surface(algorithm="dataset_surface").compute_normals(cell_normals=False,
                                                      split_vertices=False)
        if self.actor is not None:
            self.p.remove_actor(self.actor)
        self.actor = self.p.add_mesh(surf, scalars="rgb", rgb=True,
                                     smooth_shading=True, ambient=0.28,
                                     diffuse=0.85, specular=0.12,
                                     specular_power=18, show_scalar_bar=False)
        self.set_camera(k, n)
        self.p.render()
        img = np.asarray(self.p.screenshot(return_img=True))
        # other cities: hidden when a cloud is in front
        xy = self.project([(lo, la, 0.02) for _, la, lo in CITIES])
        labels = [(nm, x, y, "city") for (nm, la, lo), (x, y) in zip(CITIES, xy)
                  if not self.occluded(lo, la, z)]
        # Maldives: atoll outlines, capitals and Malé are ALWAYS shown (on top)
        rings = []
        for a, ring in self.outlines:
            sxy = np.array(self.project([(lo, la, 0.0) for lo, la in ring]))
            rings.append((a, sxy))
        caps = self.project([(c[5], c[4], 0.0) for c in ATOLLS] +
                            [(MALE[1], MALE[0], 0.0)])
        labels.append(("Malé", *caps[-1], "male"))
        for i, c in enumerate(ATOLLS):
            east = max((r[:, 0].max() for a, r in rings if a == i), default=caps[i][0])
            labels.append(((c[0], c[3]), caps[i][0], caps[i][1], "capital", east))
        return img, labels, rings



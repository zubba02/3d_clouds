def load_series(args, times):
    if args.demo:
        return demo_bt_series(times), "Synthetic test field — NOT real observations"
    area = target_area()
    os.makedirs(args.cache, exist_ok=True)
    if args.source == "himawari":
        items, reader = times, himawari_bt
        fetch = lambda t: himawari_fetch(t, args.cache)
        credit = "Data: JMA Himawari-9 AHI B13 via NOAA Open Data (AWS)"
    else:
        items, reader = meteosat_products(times), meteosat_bt
        fetch = lambda p: meteosat_fetch(p, args.cache)
        credit = "Data: EUMETSAT Meteosat IODC SEVIRI IR 10.8"
    print(f"Downloading {len(items)} timesteps ({args.source})...")
    with ThreadPoolExecutor(args.workers) as pool:
        files = list(pool.map(fetch, items))
    bts = []
    for t, f in zip(times, files):
        if not f:
            print(f"  {t:%H:%M} UTC missing"); bts.append(None); continue
        try:
            bts.append(reader(f, area)); print(f"  {t:%H:%M} UTC ok")
        except Exception as e:
            print(f"  {t:%H:%M} UTC failed: {e}"); bts.append(None)
    return bts, credit + "  ·  heights estimated from IR temperature"


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    yesterday = (dt.datetime.now(MVT) - dt.timedelta(days=1)).date()
    ap.add_argument("--date", type=dt.date.fromisoformat, default=yesterday,
                    help="Maldives local date YYYY-MM-DD (default: yesterday)")
    ap.add_argument("--source", choices=["himawari", "meteosat"], default="himawari")
    ap.add_argument("--step", type=int, default=20, help="minutes between frames")
    ap.add_argument("--fps", type=float, default=12)
    ap.add_argument("--workers", type=int, default=6)
    ap.add_argument("--cache", default="sat_cache")
    ap.add_argument("--out", default=None, help="output .gif path")
    ap.add_argument("--no-mp4", action="store_true")
    ap.add_argument("--gif-width", type=int, default=560,
                    help="GIF width in px (MP4 keeps full size)")
    ap.add_argument("--interp", type=int, default=2,
                    help="smooth motion: N-1 blended frames between satellite frames")
    ap.add_argument("--elev", type=float, default=62,
                    help="camera tilt in degrees (90 = straight down)")
    ap.add_argument("--orbit", type=float, default=32,
                    help="total degrees the camera swings around (0 = fixed)")
    ap.add_argument("--zoom", type=float, default=1.0, help=">1 zooms in")
    ap.add_argument("--demo", action="store_true")
    args = ap.parse_args()

    times = frame_times(args.date, args.step)
    out = args.out or f"maldives_clouds_3d_{args.date}{'_demo' if args.demo else ''}.gif"

    bts, credit = load_series(args, times)
    pairs = [(t, b) for t, b in zip(times, bts) if b is not None]
    if not pairs:
        sys.exit("No usable imagery.")

    # temporal interpolation for smoother motion
    if args.interp > 1 and len(pairs) > 1:
        smooth = []
        for (t0, b0), (t1, b1) in zip(pairs[:-1], pairs[1:]):
            for j in range(args.interp):
                w = j / args.interp
                smooth.append((t0 + (t1 - t0) * w, (1 - w) * b0 + w * b1))
        smooth.append(pairs[-1])
        pairs = smooth

    r = Renderer(coastlines(), elev=args.elev, orbit=args.orbit, dist=27 / args.zoom)
    frames = []
    for k, (t, bt) in enumerate(pairs):
        img, labels, rings = r.frame(bt, k, len(pairs))
        frames.append(overlay(img, labels, rings, t, k, len(pairs), bt, credit, args.demo))
        print(f"  rendered {k + 1}/{len(pairs)}", end="\r")
    print()

    gh = int(HEIGHT * args.gif_width / WIDTH)
    small = [Image.fromarray(f).resize((args.gif_width, gh), Image.LANCZOS)
             for f in frames]
    # Shared palette built from many frames + the full colour scale, so the
    # enhanced-IR rainbow survives the 256-colour GIF limit.
    idx = np.linspace(0, len(small) - 1, min(10, len(small))).astype(int)
    ramp = bt_to_rgb(np.linspace(300, 175, args.gif_width))
    ramp_img = Image.fromarray(np.repeat(ramp[None], 40, 0))
    sample = Image.new("RGB", (args.gif_width, gh * len(idx) + 40 * 4))
    for j, i in enumerate(idx):
        sample.paste(small[i], (0, j * gh))
    for j in range(4):                       # weight the ramp so it gets entries
        sample.paste(ramp_img, (0, gh * len(idx) + 40 * j))
    pal = sample.quantize(256, method=Image.Quantize.MAXCOVERAGE)
    gif = [im.quantize(palette=pal, dither=Image.Dither.FLOYDSTEINBERG) for im in small]
    durs = [int(1000 / args.fps)] * (len(gif) - 1) + [1200]
    gif[0].save(out, save_all=True, append_images=gif[1:], duration=durs,
                loop=0, optimize=False)
    print("Saved", out)

    # MP4 is optional (needs `pip install imageio-ffmpeg`); the GIF is already safe
    if not args.no_mp4:
        mp4 = os.path.splitext(out)[0] + ".mp4"
        try:
            import imageio.v2 as imageio
            imageio.mimsave(mp4, frames, fps=args.fps, codec="libx264", quality=8,
                            macro_block_size=8)
            print("Saved", mp4)
        except Exception as e:
            if os.path.exists(mp4):
                os.remove(mp4)                      # don't leave a broken file
            print(f"MP4 skipped ({type(e).__name__}). For video output run:"
                  "  pip install imageio-ffmpeg")


if __name__ == "__main__":
    main()

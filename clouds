_FONT_CACHE = {}


def _font(size, bold=False, mono=False):
    """DejaVu fonts bundled with matplotlib (same on Windows/Mac/Linux)."""
    key = (size, bold, mono)
    if key in _FONT_CACHE:
        return _FONT_CACHE[key]
    name = ("DejaVuSansMono" if mono else "DejaVuSans") + ("-Bold" if bold or mono else "")
    dirs = []
    try:
        import matplotlib
        dirs.append(os.path.join(matplotlib.get_data_path(), "fonts", "ttf"))
    except ImportError:
        pass
    dirs += ["/usr/share/fonts/truetype/dejavu", "C:/Windows/Fonts", "/Library/Fonts", ""]
    fallbacks = [name + ".ttf", "arialbd.ttf" if bold else "arial.ttf", "segoeui.ttf"]
    for nm in fallbacks:
        for d in dirs:
            try:
                f = ImageFont.truetype(os.path.join(d, nm), size)
                _FONT_CACHE[key] = f
                return f
            except OSError:
                pass
    f = ImageFont.load_default(size)
    _FONT_CACHE[key] = f
    return f


def overlay(img, labels, rings, t_utc, k, n, bt, credit, demo):
    im = Image.fromarray(img).convert("RGBA")
    W, H = im.size
    layer = Image.new("RGBA", im.size, (0, 0, 0, 0))
    d = ImageDraw.Draw(layer)

    # atoll rim outlines - drawn over the clouds so they're always visible
    for _, r in rings:
        pts = [tuple(p) for p in r]
        d.line(pts, fill=(5, 20, 30, 150), width=4, joint="curve")      # dark halo
        d.line(pts, fill=(110, 240, 225, 235), width=2, joint="curve")  # bright rim

    f_city, f_cap, f_atoll = _font(17, True), _font(13, True), _font(13)
    # Atoll + capital labels in one tidy column east of the archipelago, with
    # leader lines to each capital (Malé gets its own gold row).
    rows = [(l[0], l[1], l[2], False) for l in labels if l[3] == "capital"]
    male = [l for l in labels if l[3] == "male"]
    if male:
        rows.append(((None, "Malé"), male[0][1], male[0][2], True))
    rows = [r_ for r_ in rows if 0 < r_[1] < W and 150 < r_[2] < H - 130]
    if rows:
        ring_east = max([r[:, 0].max() for _, r in rings] or [0])
        col_x = min(max(ring_east, max(r_[1] for r_ in rows)) + 28, W - 260)
        rows.sort(key=lambda r_: r_[2])
        ys, last = [], -1e9
        for r_ in rows:                       # push rows apart (min 16 px)
            last = max(r_[2], last + 16)
            ys.append(last)
        shift = max(0, ys[-1] - (H - 140))    # keep the column on screen
        ys = [y_ - shift for y_ in ys]
        for ((atoll, capital), x, y, is_male), ly in zip(rows, ys):
            d.line([(x, y), (col_x - 14, ly), (col_x - 4, ly)],
                   fill=(255, 255, 255, 90), width=1)
            if is_male:
                d.regular_polygon((x, y, 7), 4, rotation=45, fill=(255, 214, 64, 255),
                                  outline=(0, 0, 0, 200))
                d.text((col_x, ly), "MALÉ  (capital)", font=_font(15, True),
                       fill=(255, 214, 64, 255), anchor="lm",
                       stroke_width=2, stroke_fill=(5, 15, 25, 230))
                continue
            d.ellipse([x - 3.5, y - 3.5, x + 3.5, y + 3.5], fill=(255, 255, 255, 255),
                      outline=(0, 40, 50, 220))
            w_atoll = d.textlength(atoll + "  ", font=f_atoll)
            d.text((col_x, ly), atoll + "  ", font=f_atoll, fill=(130, 240, 228, 255),
                   anchor="lm", stroke_width=2, stroke_fill=(5, 15, 25, 220))
            d.text((col_x + w_atoll, ly), capital, font=f_cap, fill=(255, 255, 255, 255),
                   anchor="lm", stroke_width=2, stroke_fill=(5, 15, 25, 220))

    for name, x, y, kind, *_ in labels:
        if kind != "city" or not (0 < x < W and 150 < y < H - 130):
            continue
        d.ellipse([x - 4, y - 4, x + 4, y + 4], fill=(255, 255, 255, 255),
                  outline=(0, 0, 0, 160))
        d.text((x + 9, y), name, font=f_city, fill=(255, 255, 255, 255),
               anchor="lm", stroke_width=2, stroke_fill=(10, 14, 22, 200))

    # top gradient for legibility
    for y in range(170):
        d.line([(0, y), (W, y)], fill=(12, 16, 24, int(200 * (1 - y / 170))))
    t_loc = t_utc.astimezone(MVT)
    d.text((28, 22), "MALDIVES & SRI LANKA  ·  3D SATELLITE CLOUDS", font=_font(26, True),
           fill=(255, 255, 255, 255))
    d.text((28, 60), f"{t_loc:%d %b %Y   %H:%M} MVT", font=_font(30, mono=True),
           fill=(255, 214, 64, 255))
    d.text((30, 100), f"{t_utc:%H:%M} UTC   ·   IR 10.4 µm cloud-top temperature",
           font=_font(16), fill=(200, 208, 222, 230))
    # day progress
    d.rounded_rectangle([28, 132, W - 28, 136], 2, fill=(255, 255, 255, 50))
    d.rounded_rectangle([28, 132, 28 + (W - 56) * (k + 1) / n, 136], 2,
                        fill=(255, 214, 64, 230))

    # deep-convection readout
    deep = np.mean(np.nan_to_num(bt, nan=300) < 210) * 100
    d.text((W - 28, 100), f"deep convection {deep:4.1f}%", font=_font(16, True),
           fill=(255, 120, 90, 255) if deep > 1 else (200, 208, 222, 200),
           anchor="ra")

    # legend bar at bottom
    for y in range(H - 120, H):
        d.line([(0, y), (W, y)], fill=(12, 16, 24, int(210 * (y - H + 120) / 120)))
    x0, x1, yb = 120, W - 120, H - 70
    temps = np.linspace(290, 185, x1 - x0)
    cols = bt_to_rgb(temps)
    for i, c in enumerate(cols):
        d.line([(x0 + i, yb), (x0 + i, yb + 12)], fill=tuple(int(v) for v in c) + (255,))
    d.rectangle([x0, yb, x1, yb + 12], outline=(255, 255, 255, 120))
    for tk, lbl in [(280, "low"), (250, "mid"), (221, "−52°C"),
                    (203, "−70°C"), (186, "−87°C")]:
        xi = x0 + (290 - tk) / 105 * (x1 - x0)
        d.text((xi, yb + 18), lbl, font=_font(13), fill=(220, 226, 236, 230), anchor="ma")
    d.text((W / 2, yb - 26), "cloud-top temperature  —  red = intense thunderstorms",
           font=_font(15), fill=(220, 226, 236, 230), anchor="ma")
    d.text((W - 14, H - 14), credit, font=_font(11), fill=(150, 160, 180, 200),
           anchor="rd")

    if demo:
        wm = Image.new("RGBA", im.size, (0, 0, 0, 0))
        ImageDraw.Draw(wm).text((W / 2, H / 2), "SYNTHETIC DEMO DATA",
                                font=_font(64, True), fill=(255, 255, 255, 55),
                                anchor="mm")
        layer = Image.alpha_composite(layer, wm.rotate(28, center=(W / 2, H / 2)))
    return np.asarray(Image.alpha_composite(im, layer).convert("RGB"))



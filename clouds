def bt_to_rgb(bt):
    t = np.array([s[0] for s in BT_STOPS], float)[::-1]
    c = np.array([s[1] for s in BT_STOPS], float)[::-1]
    b = np.clip(np.nan_to_num(bt, nan=300.0), t[0], t[-1])
    return np.stack([np.interp(b, t, c[:, i]) for i in range(3)], -1).astype(np.uint8)


def bt_to_height_km(bt):
    """Cloud-top height from IR temperature; ~0 for clear sky."""
    h = (T_SURF - np.nan_to_num(bt, nan=T_SURF)) / LAPSE - 1.6
    return np.clip(h, 0, 17)


# ---------------------------------------------------------------------------
# Grid / time helpers
# ---------------------------------------------------------------------------
NX = int(round((LON_MAX - LON_MIN) / RES))
NY = int(round((LAT_MAX - LAT_MIN) / RES))


def grid_lonlat():
    """Pixel-centre lon/lat of the render grid - exactly matches target_area()."""
    dx, dy = (LON_MAX - LON_MIN) / NX, (LAT_MAX - LAT_MIN) / NY
    lons = LON_MIN + dx * (np.arange(NX) + 0.5)
    lats = LAT_MAX - dy * (np.arange(NY) + 0.5)               # north -> south
    return np.meshgrid(lons, lats)


def target_area():
    from pyresample import create_area_def
    return create_area_def("maldives", "EPSG:4326",
                           area_extent=(LON_MIN, LAT_MIN, LON_MAX, LAT_MAX),
                           shape=(NY, NX), units="degrees")


def frame_times(local_date, step_min):
    start = dt.datetime.combine(local_date, dt.time(0, 0), tzinfo=MVT)
    return [(start + dt.timedelta(minutes=i * step_min)).astimezone(dt.timezone.utc)
            for i in range(24 * 60 // step_min)]


# ---------------------------------------------------------------------------
# Coastlines (GSHHS full resolution, cached after first use)
# ---------------------------------------------------------------------------
def coastlines(cache=f"coast_cache_{LON_MIN}_{LON_MAX}_{LAT_MIN}_{LAT_MAX}.npz"):
    if os.path.exists(cache):
        d = np.load(cache, allow_pickle=True)
        return list(d["segs"])
    # GSHHS full-resolution data from the pure-data package `basemap-data-hires`
    # (read directly - the `basemap` library itself is NOT needed).
    import importlib.util
    spec = importlib.util.find_spec("mpl_toolkits.basemap_data")
    if spec is None or not spec.submodule_search_locations:
        print("WARNING: coastline data not found - run `pip install basemap-data-hires`."
              " Continuing without coastlines.")
        return []
    ddir = list(spec.submodule_search_locations)[0]
    meta = os.path.join(ddir, "gshhsmeta_f.dat")
    data = os.path.join(ddir, "gshhs_f.dat")
    if not (os.path.exists(meta) and os.path.exists(data)):
        print("WARNING: gshhs_f.dat missing - run `pip install basemap-data-hires`.")
        return []

    print("Extracting full-resolution coastlines (one-off)...")
    segs = []
    with open(meta) as fm, open(data, "rb") as fd:
        for line in fm:
            f = line.split()
            south, north = float(f[3]), float(f[4])
            if north < LAT_MIN or south > LAT_MAX:
                continue
            npts, offset, nbytes = int(f[2]), int(f[5]), int(f[6])
            fd.seek(offset)
            xy = np.frombuffer(fd.read(nbytes), dtype="<f4").astype(float)
            xy = xy.reshape(npts, 2)                       # columns: lon, lat
            xy[:, 0] = np.where(xy[:, 0] > 180, xy[:, 0] - 360, xy[:, 0])
            inside = ((xy[:, 0] >= LON_MIN) & (xy[:, 0] <= LON_MAX) &
                      (xy[:, 1] >= LAT_MIN) & (xy[:, 1] <= LAT_MAX))
            if not inside.any():
                continue
            # split into runs of consecutive in-domain points
            edges = np.flatnonzero(np.diff(np.r_[0, inside.astype(int), 0]))
            for a, b in zip(edges[::2], edges[1::2]):
                if b - a > 1:
                    segs.append(xy[a:b])
            if inside.all() and len(xy) > 2:                # close islands
                segs[-1] = np.vstack([segs[-1], segs[-1][:1]])
    np.savez(cache, segs=np.array(segs, dtype=object))
    print(f"  {len(segs)} coastline segments")
    return segs


def atoll_outlines(segs, gap=0.12, pad=0.022):
    """Rim outlines for each atoll, built from the island coastlines.

    Islands are assigned to the nearest administrative-atoll centre, split into
    natural sub-atolls (islands closer than `gap` degrees chain together), and
    each group gets a padded, smoothed convex hull - a good stand-in for the
    reef rim. Returns a list of (atoll_index, Nx2 lon/lat array).
    """
    from scipy.cluster.hierarchy import fcluster, linkage
    from scipy.spatial import ConvexHull
    isl = [s for s in segs
           if 72.3 < s[:, 0].mean() < 74.0 and -1.0 < s[:, 1].mean() < 7.3]
    if not isl:
        return []
    cent = np.array([s.mean(0) for s in isl])
    ctr = np.array([[lo, la] for _, la, lo, *_ in ATOLLS])
    owner = np.argmin(((cent[:, None] - ctr[None]) ** 2).sum(-1), 1)

    def chaikin(p, n=3):                    # corner-cutting smoothing
        for _ in range(n):
            q = np.roll(p, -1, 0)
            p = np.stack([0.75 * p + 0.25 * q, 0.25 * p + 0.75 * q], 1).reshape(-1, 2)
        return p

    out = []
    for a in range(len(ATOLLS)):
        idx = np.flatnonzero(owner == a)
        if len(idx) == 0:
            continue
        sub = (fcluster(linkage(cent[idx], "single"), gap, "distance")
               if len(idx) > 1 else np.array([1]))
        for c in np.unique(sub):
            pts = np.vstack([isl[i] for i in idx[sub == c]])
            mid = pts.mean(0)
            try:
                hull = pts[ConvexHull(pts).vertices]
            except Exception:                # too few / collinear points
                hull = pts
            v = hull - mid
            r = np.hypot(v[:, 0], v[:, 1])[:, None]
            hull = mid + v * (r + pad) / np.maximum(r, 1e-9)
            if len(hull) < 3:                # single tiny island -> small circle
                t = np.linspace(0, 2 * np.pi, 16, endpoint=False)
                hull = mid + pad * np.c_[np.cos(t), np.sin(t)]
            ring = chaikin(hull)
            out.append((a, np.vstack([ring, ring[:1]])))
    return out


